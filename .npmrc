ignore-scripts=true
save-exact=true
fund=false
audit=false
engine-strict=true

# Pin peer-dependency resolution to npm's default STRICT behaviour.
#
# This line exists because its absence cost this repository weeks of red CI.
# A developer's user-level ~/.npmrc carried `legacy-peer-deps=true`, which
# silently downgrades an ERESOLVE conflict to a warning. `npm ci` therefore
# succeeded on that machine and failed on every CI runner, where no such file
# exists -- and the failure was attributed to the runner rather than to the
# manifest, because "works locally" was taken as evidence.
#
# Project config overrides user config, so this makes the developer machine
# reproduce CI's resolution. Never set this to true to make an install pass:
# that hides a real dependency conflict instead of resolving it.
legacy-peer-deps=false
